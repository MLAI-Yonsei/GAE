# Copy this file to .env, edit the paths, and source it before running any scripts:
#   cp .env.example .env && source .env

# Repository root — every shell script under scripts/ runs `cd ${REPO_ROOT}` early on.
REPO_ROOT=.

# Root for project data (checkpoints, preprocessed datasets, etc.).
# All scripts expect ${REPO_DATA}/checkpoints and ${REPO_DATA}/data to exist.
REPO_DATA=./data

# Root for HuggingFace / datasets library caches.
# Often the same path as REPO_DATA.
DATA_ROOT=./data

# Optional: HuggingFace Hub token, used only when accessing gated datasets.
# Read by ood_utils/data_timeshift.py via os.environ["HF_TOKEN"].
HF_TOKEN=
